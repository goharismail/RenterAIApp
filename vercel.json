{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "renteraiapp.com"
        }
      ],
      "destination": "https://www.renteraiapp.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "renteraiapp.com"
        }
      ],
      "destination": "https://www.renteraiapp.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
